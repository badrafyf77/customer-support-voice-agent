# Voice Chat Configuration
# Copy this to .env and configure your settings

# ============================================
# OPTION 1: OpenAI - DEFAULT
# ============================================
# Each agent picks its own model in its config.yaml
# (supervisor: gpt-5.4-mini, orders agent: gpt-5.5).
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=your_openai_key

# ============================================
# OPTION 2: vLLM (local open model on your own GPU)
# ============================================
# LLM_PROVIDER=vllm
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# VLLM_BASE_URL=http://vllm:8000/v1  # Use 'vllm' for Docker

# ============================================
# Common Settings (All Providers)
# ============================================
LOG_LEVEL=INFO
MAX_AUDIO_QUEUE_SIZE=50
VOICE_RUNTIME_MIN_WARM=1
VOICE_RUNTIME_MAX_CONCURRENT=1
VOICE_RUNTIME_IDLE_TTL_SECONDS=300
VOICE_RUNTIME_ACQUIRE_TIMEOUT_SECONDS=30
VLLM_STARTUP_TIMEOUT_SECONDS=180
VLLM_HEALTHCHECK_INTERVAL_SECONDS=2
# STT_REALTIME_MODEL is only used when STT_USE_MAIN_MODEL_FOR_REALTIME=false
STT_MODEL=medium.en
STT_REALTIME_MODEL=small.en
STT_USE_MAIN_MODEL_FOR_REALTIME=true
TURN_DETECTION_DEVICE=cpu

# TTS Engine (unchanged regardless of LLM provider)
# TTS_ENGINE=kokoro  # Options: kokoro, orpheus, coqui
