# Copy to backend/.env. Docker Compose reads this file automatically.
# Put your real token ONLY in .env (ignored by Git and excluded from image builds).
HF_TOKEN=

# Download the pinned Whisper base + trained Darija LoRA from HF, then merge
# and create ready-to-run CTranslate2 files automatically during Compose setup.
ASR_SOURCE=huggingface
ASR_EXPORT_CPU_THREADS=4
# Optional already-prepared local export (requires docker-compose.asr-local.yml):
# ASR_EXPORT_DIR=/teamspace/studios/this_studio/darija-asr-export

# Publish this Studio port using Lightning's port panel.
BACKEND_PORT=8080

# Candidate for the first combined L4 run; not yet a measured/tuned allocation.
VLLM_GPU_MEMORY_UTILIZATION=0.40

# Selected voice; keep the 32-step baseline used by this release.
SILMA_VOICE_ID=voice1
SILMA_CHECKPOINT_VARIANT=main
SILMA_REQUEST_TIMEOUT_SECONDS=120

LOG_LEVEL=INFO
MAX_AUDIO_QUEUE_SIZE=50
VLLM_STARTUP_TIMEOUT_SECONDS=1200
VLLM_HEALTHCHECK_INTERVAL_SECONDS=2

# Model IDs/pins, container paths, internal URLs and concurrency=1 are wired
# in docker-compose.yml. No OpenAI/Supabase credentials are needed for chat.
