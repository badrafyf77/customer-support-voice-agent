# Inject HF_TOKEN using Lightning runtime secrets; never commit it here.
VOICE_AGENT=chat
VOICE_PROFILE=darija
DARIJA_STATE_ROOT=/teamspace/studios/this_studio/darija-runtime
DARIJA_MODEL_ROOT=/teamspace/studios/this_studio/darija-models
HF_HOME=/teamspace/studios/this_studio/darija-cache/huggingface
TORCH_HOME=/teamspace/studios/this_studio/darija-cache/torch
STT_MODEL=/teamspace/studios/this_studio/darija-models/asr
STT_REALTIME_MODEL=/teamspace/studios/this_studio/darija-models/asr
STT_USE_MAIN_MODEL_FOR_REALTIME=true
TURN_DETECTION_DEVICE=cpu
TURN_DETECTION_MODEL=/teamspace/studios/this_studio/darija-models/turn
LLM_PROVIDER=vllm
LLM_MODEL=MBZUAI-Paris/Atlas-Chat-2B
VLLM_BASE_URL=http://127.0.0.1:8001/v1
SILMA_TTS_BASE_URL=http://127.0.0.1:8002
# User selected voice1 + main from the paired listening comparison.
SILMA_VOICE_ID=voice1
SILMA_CHECKPOINT_VARIANT=main
SILMA_REQUEST_TIMEOUT_SECONDS=120
VOICE_RUNTIME_MIN_WARM=1
VOICE_RUNTIME_MAX_CONCURRENT=1
VOICE_RUNTIME_ACQUIRE_TIMEOUT_SECONDS=30
# Candidate budget for the first combined run; NOT an L4-validated allocation.
# Never reuse the old 0.80 allocation. Adopt a value only after load/listening review.
VLLM_GPU_MEMORY_UTILIZATION=0.40
